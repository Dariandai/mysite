---
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = import.meta.glob('../content/posts/*.md', { eager: true });

const parsePostDate = (d: unknown) => {
  const m = String(d ?? '').match(/^(\d{4})[-.](\d{1,2})[-.](\d{1,2})/);
  if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])).getTime();
  const t = new Date(String(d)).getTime();
  return Number.isNaN(t) ? 0 : t;
};

const blogPosts = Object.values(allPosts)
  .map((post: any) => {
    const slug = post.file.split('/').pop()?.replace('.md', '') ?? '';
    return {
      date: String(post.frontmatter.date ?? '').slice(0, 10).replace(/-/g, '.'),
      titleEn: post.frontmatter.title,
      titleCn: post.frontmatter.titleCn,
      excerpt: post.frontmatter.description,
      url: `/blog/${slug}/`,
      _ts: parsePostDate(post.frontmatter.date),
    };
  })
  .sort((a: any, b: any) => b._ts - a._ts)
  .slice(0, 3)
  .map((post: any) => ({
    date: post.date,
    titleEn: post.titleEn,
    titleCn: post.titleCn,
    excerpt: post.excerpt,
    url: post.url,
  }));

const works = [
    {
        titleEn: 'FileTools',
        titleCn: '本地文件智能检索与问答系统',
        image: 'https://img.dar1an.dpdns.org/Picgo/2026/03-09-02-46-33.png',
        url: '/portfolio/project-alpha/'
    },
    {
        titleEn: 'System UI',
        titleCn: '后台数据可视化界面',
        image: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2670&auto=format&fit=crop',
        url: '/portfolio/system-ui/'
    }
];

const tools = [
    { name: 'Figma', desc: '最强大的界面协作设计工具。', icon: 'ri-pencil-ruler-2-fill' },
    { name: 'GitHub', desc: '全球最大的开源代码托管平台。', icon: 'ri-github-fill' },
    { name: 'Dribbble', desc: '寻找顶级设计师的灵感社区。', icon: 'ri-dribbble-line' },
    { name: 'Vercel', desc: '极速的前端部署与托管平台。', icon: 'ri-cloud-windy-fill' }
];

const skills = [
    { category: 'Development', icon: 'ri-code-box-line', items: ['Python / PyTorch / Flask', 'FastAPI / RESTful API', 'HTML / CSS / JavaScript', 'Java'] },
    { category: 'Testing', icon: 'ri-bug-line', items: ['Selenium / Pytest / Requests', 'JMeter Performance Testing', 'Postman API Testing', 'Test Case Design / CI'] },
    { category: 'Tools & DB', icon: 'ri-database-2-line', items: ['MySQL / MongoDB', 'Git / Docker / Linux', 'JIRA / 禅道', 'Swagger / Node.js'] }
];
---

<BaseLayout>
    <!-- 1. 主页 (Home) -->
    <section id="home" aria-label="Home section">
        <div class="hero-text">
            <div class="hero-label">
                <span class="en">WORK IN PROGRESS &amp; DEVELOPER</span>
            </div>
            <h1 class="en">Hello,<br>I'm Darian<span class="hero-cn-inline">·代宇</span></h1>
            <div class="text-group hero-intro">
                <p class="en hero-intro-en">Finding my way and digging deep into how things work. Training for the long game.</p>
                <p class="cn hero-intro-cn">探索技术之径，穷理事物之微，修身砺志赴远。</p>
            </div>

            <a href="/portfolio/" class="btn-connect">
                <span class="en">Check Portfolio</span>
                <span class="cn">查看作品</span>
            </a>
        </div>

        <div class="hero-img">
            <img
                src="https://img.dar1an.dpdns.org/Picgo/2025/12-02-20-24-54.png"
                alt="Darian portrait"
                fetchpriority="high"
                decoding="async"
                width="800"
                height="1200"
            >
        </div>
    </section>

    <!-- 2. 关于 (About) -->
    <section id="about" aria-label="Skills and tools section">
        <h2 class="section-title">
            <span class="sub">Skills & Tools / 技能与工具</span>
            <div class="text-group">
                <a href="/about/" class="section-link">
                    <span class="en">What I Do</span>
                    <span class="cn section-title-cn">我的技能栈</span>
                </a>
            </div>
        </h2>
        <div class="content-grid skills-grid-home" role="list">
            {skills.map((skill, index) => (
                <article class="unified-card skill-card" data-animate="fade-up" data-delay={index + 1} role="listitem">
                    <div class="card-icon-header">
                        <i class={skill.icon}></i>
                        <span>{skill.category}</span>
                    </div>
                    <ul class="card-items">
                        {skill.items.map(item => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </article>
            ))}
        </div>
        <div class="skills-cta">
            <a href="/about/" class="btn-connect">
                <span class="en">Learn More About Me</span>
                <span class="cn">了解更多关于我</span>
            </a>
        </div>
    </section>

    <!-- 3. 博客 (Blog) -->
    <section id="blog" aria-label="Blog articles section">
        <h2 class="section-title">
            <span class="sub">Thinking / 思考</span>
            <div class="text-group">
                <a href="/blog/" class="section-link">
                    <span class="en">Latest Articles</span>
                    <span class="cn section-title-cn">最新博客文章</span>
                </a>
            </div>
        </h2>
        <div class="content-grid blog-grid-home" role="list">
            {blogPosts.map((post, index) => (
                <a href={post.url} class="unified-card blog-card-home" data-animate="fade-up" data-delay={index + 1} role="listitem">
                    <div class="card-meta">
                        <span class="card-num">{String(index + 1).padStart(2, '0')}</span>
                        <span class="card-date">{post.date}</span>
                    </div>
                    <div class="card-titles">
                        <span class="title-en">{post.titleEn}</span>
                        <span class="title-cn">{post.titleCn}</span>
                    </div>
                    <p class="card-excerpt">{post.excerpt}</p>
                </a>
            ))}
        </div>
    </section>

    <!-- 3. 作品 (Works) -->
    <section id="portfolio" aria-label="Portfolio showcase section">
        <h2 class="section-title">
            <span class="sub">Selected Works / 作品集</span>
            <div class="text-group">
                <a href="/portfolio/" class="section-link">
                    <span class="en">Portfolio Showcase</span>
                    <span class="cn section-title-cn">精选项目展示</span>
                </a>
            </div>
        </h2>
        <div class="content-grid works-grid-home" role="list">
            {works.map((work, index) => (
                <a href={work.url} class="unified-card work-card" data-animate="fade-up" data-delay={index + 1} role="listitem">
                    <div class="work-image-wrapper">
                        <img src={work.image} alt={work.titleEn} loading="lazy" decoding="async" width="600" height="400" />
                    </div>
                    <div class="work-info">
                        <span class="work-category">PROJECT</span>
                        <div class="work-titles">
                            <span class="title-en">{work.titleEn}</span>
                            <span class="title-cn">{work.titleCn}</span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- 4. 分享 (Share) -->
    <section id="share" aria-label="Tools and resources section">
        <h2 class="section-title">
            <span class="sub">Tools & Resources / 工具资源</span>
            <div class="text-group">
                <a href="/share/" class="section-link">
                    <span class="en">Worth Sharing</span>
                    <span class="cn section-title-cn">好用的工具与网站推荐</span>
                </a>
            </div>
        </h2>

        <div class="content-grid tools-grid-home" role="list">
            {tools.map((tool, index) => (
                <a href="/share/" class="unified-card tool-card" data-animate="fade-up" data-delay={index + 1} role="listitem">
                    <div class="tool-icon-wrapper">
                        <i class={tool.icon}></i>
                    </div>
                    <div class="tool-content">
                        <span class="tool-name">{tool.name}</span>
                        <span class="tool-desc">{tool.desc}</span>
                    </div>
                </a>
            ))}
        </div>

        <footer>
            <div class="text-group">
                <span class="en">&copy; 2026 Dar1an. All Rights Reserved.</span>
                <span class="cn">保留所有权利。</span>
            </div>
        </footer>
    </section>
</BaseLayout>

<script>
    // 使用统一的堆叠卡片模块
    import { initStackingCards } from '../scripts/stacking-cards.js';

    initStackingCards({
        sections: 'section'
    });
</script>
